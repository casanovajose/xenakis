function(xen_define_xplugin)
    set(options "")
    set(oneValue ID TARGET CLASS HEADER)
    set(multiValue SOURCES INCLUDES)
    cmake_parse_arguments(ARG "${options}" "${oneValue}" "${multiValue}" ${ARGN})
    if(NOT ARG_ID OR NOT ARG_TARGET OR NOT ARG_CLASS OR NOT ARG_HEADER)
        message(FATAL_ERROR "xen_define_xplugin needs ID, TARGET, CLASS, and HEADER")
    endif()
    add_library(${ARG_TARGET} STATIC ${ARG_SOURCES} ${ARG_HEADER})
    target_link_libraries(${ARG_TARGET} PUBLIC xen_kernel xen_contracts)
    target_include_directories(${ARG_TARGET} PUBLIC ${ARG_INCLUDES})
    target_compile_features(${ARG_TARGET} PUBLIC cxx_std_20)
    if(MSVC)
        target_compile_options(${ARG_TARGET} PRIVATE /W4 /permissive-)
    else()
        target_compile_options(${ARG_TARGET} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
    set_property(GLOBAL APPEND PROPERTY XEN_XPLUGIN_TARGETS "${ARG_TARGET}")
    set_property(GLOBAL APPEND PROPERTY XEN_XPLUGIN_CLASSES "${ARG_CLASS}")
    set_property(GLOBAL APPEND PROPERTY XEN_XPLUGIN_HEADERS "${ARG_HEADER}")
endfunction()

function(xen_generate_xplugin_registration)
    get_property(targets GLOBAL PROPERTY XEN_XPLUGIN_TARGETS)
    get_property(classes GLOBAL PROPERTY XEN_XPLUGIN_CLASSES)
    get_property(headers GLOBAL PROPERTY XEN_XPLUGIN_HEADERS)
    if(NOT targets)
        set(targets "")
    endif()

    set(generated "${CMAKE_BINARY_DIR}/generated/XPluginRegistration.cpp")
    set(body "#include \"xen/XPluginRegistration.h\"\n")
    foreach(header IN LISTS headers)
        file(TO_CMAKE_PATH "${header}" headerPosix)
        string(APPEND body "#include \"${headerPosix}\"\n")
    endforeach()
    string(APPEND body "namespace xen {\n")
    string(APPEND body "std::vector<std::unique_ptr<XPlugin>> createXPlugins() {\n")
    string(APPEND body "    std::vector<std::unique_ptr<XPlugin>> plugins;\n")
    foreach(className IN LISTS classes)
        string(APPEND body "    plugins.push_back(std::make_unique<${className}>());\n")
    endforeach()
    string(APPEND body "    return plugins;\n}\n}\n")
    file(WRITE "${generated}" "${body}")

    add_library(xen_xplugins STATIC "${generated}")
    target_link_libraries(xen_xplugins PUBLIC xen_kernel ${targets})
    target_include_directories(xen_xplugins PUBLIC "${CMAKE_SOURCE_DIR}/shells/include")
    foreach(header IN LISTS headers)
        get_filename_component(headerDir "${header}" DIRECTORY)
        target_include_directories(xen_xplugins PRIVATE "${headerDir}")
    endforeach()
    target_compile_features(xen_xplugins PUBLIC cxx_std_20)
endfunction()
